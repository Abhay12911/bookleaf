// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AUTHOR
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_AUTHOR
  RESOLVED
  CLOSED
}

enum TicketPriority {
  CRITICAL
  LOW
  MEDIUM
  HIGH
}

enum TicketCategory {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION_AVAILABILITY
  BOOK_STATUS_PRODUCTION
  GENERAL_INQUIRY
}

model User {
  id              String          @id @default(cuid())
  sampleAuthorId  String?         @unique
  name            String?
  email           String          @unique
  password        String
  role            UserRole        @default(AUTHOR)
  phone           String?
  city            String?
  joinedDate      DateTime?
  createdAt       DateTime        @default(now())
  books           Book[]
  tickets         Ticket[]        @relation("TicketAuthor")
  assignedTickets Ticket[]        @relation("TicketAssignee")
  messages        TicketMessage[]
  notes           TicketNote[]
}

model Book {
  id                    String    @id @default(cuid())
  sampleBookId          String    @unique
  title                 String
  isbn                  String?
  genre                 String?
  publicationDate       DateTime?
  status                String
  mrp                   Float?
  authorRoyaltyPerCopy  Float?
  totalCopiesSold       Int       @default(0)
  totalRoyaltyEarned    Float     @default(0)
  royaltyPaid           Float     @default(0)
  royaltyPending        Float     @default(0)
  lastRoyaltyPayoutDate DateTime?
  printPartner          String?
  availableOn           String[]
  authorId              String
  createdAt             DateTime  @default(now())
  author                User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tickets               Ticket[]
}

model Ticket {
  id           String          @id @default(cuid())
  subject      String
  description  String
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(MEDIUM)
  category     TicketCategory  @default(GENERAL_INQUIRY)
  aiDraft      String?
  authorId     String
  bookId       String?
  assignedToId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  author       User            @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  book         Book?           @relation(fields: [bookId], references: [id], onDelete: SetNull)
  assignedTo   User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  notes        TicketNote[]
}

model TicketNote {
  id        String   @id @default(cuid())
  content   String
  ticketId  String
  authorId  String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model TicketMessage {
  id        String   @id @default(cuid())
  content   String
  ticketId  String
  senderId  String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
